  {
   "key": "feed-004",
   "alt": "Hamburg, sechs Uhr. Der Hafen ist noch nicht ganz da. Wir schon.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-005",
   "alt": "Speicherstadt, kurz vor sieben. Backstein, Wasser, Ruhe. Ungefähr so soll sich eine Websit",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-006",
   "alt": "Weiße Wand, ein Schatten, ein Fenster. Mehr braucht ein gutes Layout auch nicht.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-010",
   "alt": "Ohne Farbe, nur Druck. Ein Zeichen muss nicht laut sein, um gesehen zu werden.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-011",
   "alt": "Övelgönne im Nebel. Hamburg hat auch einen Strand. Er ist nur kälter.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-012",
   "alt": "Das Büro hat ein Fenster zum Hafen. Meistens ist es auf.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-013",
   "alt": "Bevor eine Seite gebaut wird, liegt sie so auf dem Tisch. Stoff, Holz, Messing. Daraus kom",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-014",
   "alt": "Hamburg, gezeichnet. Kräne, Barkasse, und eine Palme, die da nicht hingehört. Oder doch.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-015",
   "alt": "Sand, Schatten, Rhythmus. Gute Struktur sieht man erst, wenn das Licht stimmt.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-016",
   "alt": "Erster Kaffee, erster Entwurf. Das Meer bleibt vor dem Fenster.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-017",
   "alt": "Spiegelglatt. So sieht ein Fleet aus, wenn noch niemand wach ist.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-018",
   "alt": "Das Handbuch zu jedem Projekt. Wer es aufschlägt, findet sich zurecht, auch in fünf Jahren",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-022",
   "alt": "Alster, Oktober, kurz nach Sonnenaufgang. Hamburg kann sehr leise sein.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-023",
   "alt": "Drop 02. Creme, schwer, ein kleines Zeichen auf der Brust. Der Rest ist Haltung.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-024",
   "alt": "Ebbe. Wenn das Wasser weg ist, wird es auf einmal sehr weit.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-025",
   "alt": "Ein Bogen, drei Stufen, das Meer. Navigation kann so einfach sein.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-026",
   "alt": "Visitenkarten, Menükarten, Angebote. Alles aus einem Guss, auch die Kante.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-027",
   "alt": "Wasser, Licht, Schatten. Manchmal ist das schon das ganze Design.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-031",
   "alt": "Drop 02 hängt schon. Druck kommt, wenn er sitzt.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-032",
   "alt": "Die Cap. Ohne Aufdruck, mit Geschichte.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-033",
   "alt": "Ein Teller, eine Zutat, ein Schatten. So fangen unsere Food-Cover an.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-034",
   "alt": "Der Schlüssel zum Backoffice. Bei uns bekommt ihn jeder Kunde in die Hand.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-035",
   "alt": "Struktur von oben. Jede Stufe weiß, wohin sie führt.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-036",
   "alt": "Gedeckt, bevor der erste Gast kommt. Ein Backoffice macht genau das, nur unsichtbar.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-037",
   "alt": "Backstein und Morgenlicht. Hamburg ist unsere Basis, und das sieht man.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-038",
   "alt": "Jedes Angebot kommt bei uns so an, wie es gemeint ist: ruhig, klar, verschlossen, bis du e",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-039",
   "alt": "Ein Boot, ein Schatten. Am Morgen.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-043",
   "alt": "Nächster Stop. Der Laptop kommt mit, die Vorlagen bleiben zu Hause.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-044",
   "alt": "Was immer dabei ist. Der Rest ist in der Cloud.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  },
  {
   "key": "feed-045",
   "alt": "Halb sieben. Noch kein Wind, noch kein Plan.",
   "w": 1080,
   "h": 1350,
   "gruppe": "Feed"
  }
 ]
